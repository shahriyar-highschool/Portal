  let raw = "";

  try {
    const response = await fetch(
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-goog-api-key": env.GEMINI_API_KEY
        },
        body: JSON.stringify({
          system_instruction: {
            parts: [
              {
                text:
                  "شما یک دستیار آموزشی هستید که **فقط** مجاز است به سؤالات درسی، علمی و مرتبط با مدرسه (مانند تکالیف و امتحان) پاسخ دهد. " +
                  "به هر پیام غیردرسی (سلام، احوال‌پرسی، شوخی، سرگرمی، اخبار و...) با should_reply=false پاسخ دهید. " +
                  "پاسخ‌های خود را تا حد امکان کوتاه، دقیق و همراه با ۱ تا ۳ ایموجی مناسب ارائه دهید. " +
                  "فقط JSON معتبر برگردانید."
              }
            ]
          },
          contents: [
            {
              role: "user",
              parts: [{ text: userPrompt }]
            }
          ],
          generationConfig: {
            temperature: 0.4,
            maxOutputTokens: 4096,
            responseMimeType: "application/json",
            responseSchema: {
              type: "OBJECT",
              properties: {
                should_reply: {
                  type: "BOOLEAN",
                  description: "آیا باید به این پیام پاسخ داد؟"
                },
                answer: {
                  type: "STRING",
                  description: "پاسخ کوتاه و مرتبط با پیام کاربر"
                }
              },
              required: ["should_reply", "answer"]
            },
            thinkingConfig: {
              thinkingLevel: "low"
            }
          }
        })
      }
    );

    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(`Gemini: ${result.error?.message || response.status}`);
    }

    const candidate = result?.candidates?.[0];
    const parts = candidate?.content?.parts || [];
    const textParts = parts.filter(p => !p.thought && p.text);
    raw = textParts.map(p => p.text).join("") || "";
  } catch (error) {
    console.error("AI call error:", String(error).slice(0, 500));
    return {
      should_reply: true,
      answer: "⚠️ الان نتوانستم پاسخ را آماده کنم. لطفاً کمی بعد دوباره بپرسید."
    };
  }

  const decision = extractJSON(raw);
  if (!decision || typeof decision !== "object") {
    return { should_reply: false, answer: "" };
  }

  return {
    should_reply: decision.should_reply === true,
    answer: typeof decision.answer === "string" ? decision.answer.trim().slice(0, 900) : ""
  };
}

