async function deleteTemporaryMessage(env, chatId, messageId) {
  if (!chatId || !messageId) return;
  try {
    await bale(env, "deleteMessage", {
      chat_id: chatId,
      message_id: messageId
    });
  } catch (error) {
    console.error("Temporary message deletion error:", String(error).slice(0, 500));
  }
}

async function sendGroupError(env, chatId, replyToMessageId) {
  if (!chatId || !env.BALE_TOKEN) return;
  try {
    const payload = {
      chat_id: chatId,
      text: "⚠️ هنگام پردازش این پیام خطایی رخ داد.\nلطفاً کمی بعد دوباره تلاش کنید."
    };
    if (replyToMessageId) payload.reply_to_message_id = replyToMessageId;
    await bale(env, "sendMessage", payload);
  } catch (error) {
    console.error("Could not send group error:", String(error).slice(0, 700));
  }
}

async function sendWelcome(env, chatId) {
  await bale(env, "sendMessage", {
    chat_id: chatId,
    text:
      "سلام! 👋\n\n" +
      "من دستیار آموزشی این گروه هستم.\n" +
      "پیام‌های دریافتی را برای پیگیری بحث‌ها و تکالیف ثبت می‌کنم " +
      "و فقط وقتی لازم باشد پاسخ می‌دهم.",
    reply_markup: KEYBOARD
  });
}

async function tryClaimWelcome(env, chatId) {
  try {
    const key = `welcome:${chatId}`;
    if (await env.MEMORY.get(key)) return false;
    await env.MEMORY.put(key, "1", { expirationTtl: WELCOME_LOCK_TTL });
    return true;
  } catch (error) {
    return true;
  }
}

async function sendFinalAnswer(env, chatId, messageId, privateChat, answerText) {
  const payload = { chat_id: chatId, text: answerText };
  if (!privateChat) payload.reply_to_message_id = messageId;

  try {
    await bale(env, "sendMessage", payload);
  } catch (error) {
    await bale(env, "sendMessage", { chat_id: chatId, text: answerText }).catch(() => {});
  }
}

