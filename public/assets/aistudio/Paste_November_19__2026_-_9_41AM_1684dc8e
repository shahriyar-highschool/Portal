    const url = new URL(request.url);

    if (request.method === "GET" && url.pathname === "/") {
      return new Response("Educational Bale bot is running.");
    }

    if (request.method === "GET" && url.pathname === "/setup") {
      if (!env.SETUP_KEY || url.searchParams.get("key") !== env.SETUP_KEY) {
        return new Response("Forbidden", { status: 403 });
      }

      if (!env.BALE_TOKEN) {
        return new Response("BALE_TOKEN is missing", { status: 500 });
      }

      let publicUrl = env.PUBLIC_WORKER_URL || WORKER_URL || `${url.origin}/`;
      if (!publicUrl.endsWith("/")) publicUrl += "/";

      try {
        const result = await bale(env, "setWebhook", { url: publicUrl });
        return Response.json({ ok: true, url: publicUrl, result });
      } catch (error) {
        return new Response("Webhook setup failed.", { status: 500 });
      }
    }

    if (request.method !== "POST") {
      return new Response("Method Not Allowed", { status: 405 });
    }

    if (!env.BALE_TOKEN || !env.MEMORY || !env.GEMINI_API_KEY) {
      return new Response("Worker configuration incomplete", { status: 500 });
