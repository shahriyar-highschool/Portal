            });
            return new Response("OK");
          }

          // ذخیره متن سوال در لیست سوالات اخیر برای جلوگیری از تکرار بعدی
          await saveRecentQuizQuestion(env, category, quiz.question);

          const quizId = `${Date.now().toString(36)}_${Math.random().toString(36).substring(2, 6)}`;
          await env.MEMORY.put(
            `quiz:${quizId}`,
            JSON.stringify({
              correctIndex: quiz.correct_index,
              explanation: quiz.explanation,
              category: category,
              userId: user.id
            }),
            { expirationTtl: 600 }
          );

          const labels = ["الف) ", "ب) ", "ج) ", "د) "];
          const quizButtons = quiz.options.map((opt, idx) => [
            {
              text: `${labels[idx]}${opt}`,
              callback_data: `qans:${quizId}:${idx}`
            }
          ]);

          const questionText =
            `📝 *آزمون چهارگزینه‌ای ${category} (پایه هشتم)*\n\n` +
            `❓ ${quiz.question}\n\n` +
            `لطفاً گزینه صحیح را انتخاب کنید:`;

          await bale(env, "sendMessage", {
            chat_id: chatId,
            text: questionText,
            parse_mode: "Markdown",
            reply_markup: { inline_keyboard: quizButtons }
          });
          return new Response("OK");
        }

        // 11. بررسی پاسخ کوئیز
        if (data.startsWith("qans:")) {
          const parts = data.split(":");
          const quizId = parts[1];
          const selectedIdx = parseInt(parts[2], 10);

          const quizRaw = await env.MEMORY.get(`quiz:${quizId}`);
          if (!quizRaw) {
            await bale(env, "sendMessage", {
              chat_id: chatId,
              text: "⏳ زمان پاسخ‌گویی به این سوال به پایان رسیده یا قبلاً ثبت شده است."
            });
            return new Response("OK");
          }

          const quizData = JSON.parse(quizRaw);

          // بررسی مالکیت کوئیز
          if (quizData.userId && String(quizData.userId) !== String(user.id)) {
            await bale(env, "sendMessage", {
              chat_id: chatId,
              text: "⚠️ این آزمون مخصوص شخص دیگری طرح شده است. لطفاً از منو برای خودتان کوئیز جدید بگیرید."
            });
            return new Response("OK");
          }

          await env.MEMORY.delete(`quiz:${quizId}`);

          if (selectedIdx === quizData.correctIndex) {
            const isVip = await isUserVip(env, user.id);
            const reward = isVip ? 8 : 5;
            const newScore = await addPoint(env, chatId, user, reward);
            const vipNote = isVip ? " (پاداش VIP 👑)" : "";

            await bale(env, "sendMessage", {
              chat_id: chatId,
              text:
                `🎉 *آفرین ${user.first_name || ""}! پاسخ شما کاملاً درست بود.*\n\n` +
                `🎁 *+${reward} سکه به شما تعلق گرفت!*${vipNote}\n` +
                `💰 موجودی کل شما: ${newScore} سکه\n\n` +
                `💡 *نکته آموزشی:* ${quizData.explanation || "عالی بود!"}`,
              parse_mode: "Markdown"
            });
          } else {
            await bale(env, "sendMessage", {
              chat_id: chatId,
              text:
                `❌ متأسفانه پاسخ شما اشتباه بود!\n\n` +
                `✅ *گزینه درست:* شماره ${quizData.correctIndex + 1}\n` +
                `💡 *توضیح علمی:* ${quizData.explanation || "موفق باشید!"}`,
              parse_mode: "Markdown"
            });
          }
          return new Response("OK");
        }

        return new Response("OK");
      }

      // --------------------
      // تغییر وضعیت عضویت بات
      // --------------------
      if (update.my_chat_member) {
        const event = update.my_chat_member;
        const status = event.new_chat_member?.status;
        const chat = event.chat;
        errorChatId = chat?.id ?? null;

        if (
          chat &&
          chat.type !== "private" &&
          (status === "member" || status === "administrator") &&
          (await tryClaimWelcome(env, chat.id))
        ) {
          await sendWelcome(env, chat.id);
        }
        return new Response("OK");
      }

      // --------------------
      // پیام ویرایش‌شده
      // --------------------
      const edited = update.edited_message;
      if (edited?.chat && edited.from?.is_bot !== true) {
        const editedText = getText(edited);
        if (editedText) {
          await saveHistory(
            env,
            edited.chat.id,
            {
              id: edited.message_id,
              sender: edited.from?.first_name || "ناشناس",
              sender_id: edited.from?.id,
              time: localTime(edited.date),
              unix_time: edited.date,
              text: editedText.slice(0, 3000),
              reply_to_message_id: edited.reply_to_message?.message_id || null
            },
            { replace: true }
          );
        }
        return new Response("OK");
      }

      const message = update.message;
      if (!message?.chat || message.from?.is_bot === true) {
        return new Response("OK");
      }

      const chatId = message.chat.id;
      const text = getText(message);
      const privateChat = message.chat.type === "private";

      errorChatId = chatId;
      errorReplyToId = message.message_id;

      // --------------------
      // خوشامدگویی هنگام اضافه‌شدن بات
      // --------------------
      if (Array.isArray(message.new_chat_members) && message.new_chat_members.length > 0) {
        const botUsername = (env.BOT_USERNAME || "").replace(/^@/, "").toLowerCase();
        const botWasAdded = message.new_chat_members.some(member => {
          if (!member.is_bot) return false;
          if (botUsername) return (member.username || "").toLowerCase() === botUsername;
          return true;
        });

        if (botWasAdded && (await tryClaimWelcome(env, chatId))) {
          await sendWelcome(env, chatId);
        }
      }

      if (!text) return new Response("OK");

      // --------------------
      // ⭐ دستور ارتقا به VIP توسط ادمین با ریپلای
      // --------------------
      if (/^(?:ارتقا|ارتقاء|\/promote)$/i.test(text.trim())) {
        const adminId = env.ADMIN_USER_ID;
        if (adminId && String(message.from?.id) === String(adminId)) {
          const targetUser = message.reply_to_message?.from;
          if (!targetUser) {
            await bale(env, "sendMessage", {
              chat_id: chatId,
              text: "⚠️ لطفاً این دستور را روی پیام کاربر مورد نظر در گروه ریپلای کنید.",
              reply_to_message_id: message.message_id
            });
            return new Response("OK");
          }

          await setUserVip(env, targetUser.id, true);
          await bale(env, "sendMessage", {
            chat_id: chatId,
            text: `🎉 کاربر *${targetUser.first_name || "دانش‌آموز"}* با موفقیت به عنوان *کاربر ویژه (VIP)* 👑 ارتقا یافت!`,
            parse_mode: "Markdown",
            reply_to_message_id: message.message_id
          });
          return new Response("OK");
        }
      }

      // دستور لغو VIP توسط ادمین با ریپلای
      if (/^(?:لغو ارتقا|عادی سازی|\/demote)$/i.test(text.trim())) {
        const adminId = env.ADMIN_USER_ID;
        if (adminId && String(message.from?.id) === String(adminId)) {
          const targetUser = message.reply_to_message?.from;
          if (targetUser) {
            await setUserVip(env, targetUser.id, false);
            await bale(env, "sendMessage", {
              chat_id: chatId,
              text: `ℹ️ وضعیت VIP کاربر *${targetUser.first_name || "دانش‌آموز"}* لغو شد و به حساب عادی بازگشت.`,
              parse_mode: "Markdown",
              reply_to_message_id: message.message_id
            });
            return new Response("OK");
          }
        }
      }

      // --------------------
      // سکه بابت ارسال هر پیام (عادی: ۱ سکه | ویژه VIP: ۲ سکه)
      // --------------------
      const senderIsVip = await isUserVip(env, message.from?.id);
      await addPoint(env, chatId, message.from, senderIsVip ? 2 : 1);

      // --------------------
      // دستور مشاهده امتیاز، رتبه‌بندی و فروشگاه
      // --------------------
      if (/^(?:امتیاز|امتیاز من|\/score|رتبه|سکه)$/i.test(text.trim())) {
        const scores = await getScores(env, chatId);
        const report = await formatLeaderboard(
          env,
          scores,
          message.from?.id,
          message.from?.first_name || "شما"
        );

        const scoreMsg = await bale(env, "sendMessage", {
          chat_id: chatId,
          text: report,
          parse_mode: "Markdown",
          reply_to_message_id: message.message_id,
          reply_markup: getScoreInlineKeyboard()
        });

        // حذف پیام جدول امتیاز پس از ۱۵ ثانیه
        if (scoreMsg?.message_id && ctx?.waitUntil) {
          ctx.waitUntil(
            (async () => {
              await sleep(15000);
              await bale(env, "deleteMessage", {
                chat_id: chatId,
                message_id: scoreMsg.message_id
              }).catch(() => {});
            })()
          );
        }

        return new Response("OK");
      }

      // --------------------
      // دستور متنی: /start
      // --------------------
      if (/^\/start(?:@\w+)?(?:\s|$)/i.test(text)) {
        const startText =
          "سلام! 👋\n\n" +
          "من کلاس‌آرا هستم؛ یه دستیار آموزشی که اومده کنارت باشه تا درس خوندن و پیگیری تکالیف راحت‌تر بشه. سؤال درسی داری؟ بپرس. 📚 تکلیف یا امتحان داری؟ کمکت می‌کنم یادت بمونه. ✏️\n\n" +
          "🪙 با هر پیام درسی ۱ سکه (برای VIPها ۲ سکه) و با پاسخ به هر کوئیز ۵ سکه (برای VIPها ۸ سکه) می‌گیری! از بخش امتیاز می‌تونی رتبه خودت رو ببینی و از فروشگاه خرید کنی.";

        const payload = {
          chat_id: chatId,
          text: startText,
          reply_markup: KEYBOARD
        };
        if (!privateChat) payload.reply_to_message_id = message.message_id;

        try {
          await bale(env, "sendMessage", payload);
        } catch {
          await bale(env, "sendMessage", { chat_id: chatId, text: startText, reply_markup: KEYBOARD }).catch(() => {});
        }

        return new Response("OK");
      }

      // --------------------
      // پیام انتظار «⏳» پیش از عملیات AI درسی
      // --------------------
      try {
        const temporaryMessage = await bale(env, "sendMessage", {
          chat_id: chatId,
          text: "⏳ در حال بررسی پیام...\nقدرت گرفته از [مخیار](https://mokhyar.stormkit.dev)",
          parse_mode: "Markdown",
          reply_to_message_id: message.message_id
        });
        temporaryMessageId = temporaryMessage?.message_id ?? null;
      } catch (tempError) {
        console.error("Temporary message send failed:", String(tempError).slice(0, 300));
      }

      // --------------------
      // ثبت پیام در تاریخچه گروه
      // --------------------
      const entry = {
        id: message.message_id,
        sender: message.from?.first_name || "ناشناس",
        sender_id: message.from?.id,
        time: localTime(message.date),
        unix_time: message.date,
        text: text.slice(0, 3000),
        reply_to_message_id: message.reply_to_message?.message_id || null
      };

      const history = await saveHistory(env, chatId, entry);
      const historyForContext = history.filter(item => item.id !== message.message_id);

      // --------------------
      // پردازش هوش مصنوعی درسی (Gemini) - نامحدود و رایگان برای همه
      // --------------------
      let decision = { should_reply: false, answer: "" };
      try {
        decision = await generateDecision(env, message, historyForContext);
      } catch (aiError) {
        console.error("Decision generation failed:", String(aiError).slice(0, 500));
      }

      if (decision.should_reply && decision.answer) {
        await sendFinalAnswer(env, chatId, message.message_id, privateChat, decision.answer);
      }

      return new Response("OK");
    } catch (error) {
      console.error("Bot error:", String(error?.stack || error).slice(0, 1200));
      await sendGroupError(env, errorChatId, errorReplyToId);
      return new Response("OK");
    } finally {
      if (temporaryMessageId && errorChatId) {
        await deleteTemporaryMessage(env, errorChatId, temporaryMessageId);
      }
    }
  }
};