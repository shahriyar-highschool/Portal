async function getRecentQuizQuestions(env, category) {
  try {
    const val = await env.MEMORY.get(`quiz_recent:${category}`);
    return val ? JSON.parse(val) : [];
  } catch {
    return [];
  }
}

async function saveRecentQuizQuestion(env, category, questionText) {
  try {
    const recent = await getRecentQuizQuestions(env, category);
    const norm = questionText.replace(/\s+/g, " ").trim();
    if (recent.some(q => q.replace(/\s+/g, " ").trim() === norm)) return;

    recent.push(questionText);
    const trimmed = recent.slice(-8);
    await env.MEMORY.put(`quiz_recent:${category}`, JSON.stringify(trimmed), { expirationTtl: 86400 * 3 });
  } catch (e) {
    console.error("Save recent quiz question error:", e);
  }
}

async function generateQuizAI(env, category) {
  const recent = await getRecentQuizQuestions(env, category);
  const avoidSection = recent.length > 0
    ? `\n⚠️ این سؤالات قبلاً برای این درس پرسیده شده‌اند؛ به هیچ وجه سوالی شبیه به این‌ها یا با همین موضوع و اعداد طرح نکن:\n${recent.map((q, i) => `${i + 1}. ${q}`).join("\n")}\n`
    : "";

  const prompt = `شما طراح آزمون تیزهوشان پایه هشتم هستید.
یک سوال تستی چهارگزینه‌ای مفهومی، دقیق و سطح بالا از درس "${category}" برای پایه هشتم طرح کنید.
به سراغ بخش‌ها، فصول و مفاهیم متنوع کتاب بروید.${avoidSection}
فرمت پاسخ حتماً و فقط یک شیء JSON استاندارد مطابق ساختار تعیین‌شده باشد.`;

  try {
    const response = await fetch(
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-goog-api-key": env.GEMINI_API_KEY
        },
        body: JSON.stringify({
          contents: [{ role: "user", parts: [{ text: prompt }] }],
          generationConfig: {
            temperature: 1.0,
            responseMimeType: "application/json",
            responseSchema: {
              type: "OBJECT",
              properties: {
                question: { type: "STRING", description: "متن سوال تستی" },
                options: {
                  type: "ARRAY",
                  items: { type: "STRING" },
                  description: "لیست دقیقاً ۴ گزینه سوال"
                },
                correct_index: { type: "INTEGER", description: "ایندکس گزینه صحیح بین 0 تا 3" },
                explanation: { type: "STRING", description: "توضیح کوتاه علمی دلیل درستی پاسخ" }
              },
              required: ["question", "options", "correct_index", "explanation"]
            },
            thinkingConfig: {
              thinkingLevel: "medium"
            }
          }
        })
      }
    );

    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      console.error("Quiz API error:", response.status, result?.error?.message);
      return null;
    }

    const parts = result?.candidates?.[0]?.content?.parts || [];
    const textParts = parts.filter(p => !p.thought && p.text);
    const rawText = textParts.map(p => p.text).join("") || "";
    const quiz = extractJSON(rawText);

    if (!quiz || typeof quiz !== "object") return null;
    if (typeof quiz.question !== "string" || !quiz.question.trim()) return null;
    if (!Array.isArray(quiz.options) || quiz.options.length !== 4) return null;
    if (!Number.isInteger(quiz.correct_index) || quiz.correct_index < 0 || quiz.correct_index > 3) return null;

    return quiz;
  } catch (error) {
    console.error("Quiz generation error:", error);
    return null;
  }
}

