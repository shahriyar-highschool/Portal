// محدودیت نرخ کوئیز (عادی: ۳ در ۱۰ دقیقه | VIP: ۱۰ در ۱۰ دقیقه)
// ==================================================

async function checkQuizRateLimit(env, chatId, userId) {
  try {
    const isVip = await isUserVip(env, userId);
    const maxAllowed = isVip ? QUIZ_RATE_MAX_VIP : QUIZ_RATE_MAX_NORMAL;

    const key = `quiz_rate:${chatId}:${userId}`;
    const now = Date.now();
    const val = await env.MEMORY.get(key);
    let timestamps = [];

    if (val) {
      try {
        const parsed = JSON.parse(val);
        if (Array.isArray(parsed)) {
          timestamps = parsed.filter(
            t => typeof t === "number" && now - t < QUIZ_RATE_WINDOW_MS
          );
        }
      } catch {}
    }

    if (timestamps.length >= maxAllowed) {
      const oldestInWindow = timestamps[0];
      const waitMs = QUIZ_RATE_WINDOW_MS - (now - oldestInWindow);
      const waitSeconds = Math.max(1, Math.ceil(waitMs / 1000));
      return { allowed: false, waitSeconds, isVip, maxAllowed };
    }

    timestamps.push(now);
    await env.MEMORY.put(key, JSON.stringify(timestamps), { expirationTtl: 610 });

    return { allowed: true, remaining: maxAllowed - timestamps.length, isVip };
  } catch (error) {
    console.error("Quiz rate limit check error:", String(error).slice(0, 300));
    return { allowed: true, isVip: false };
  }
}

