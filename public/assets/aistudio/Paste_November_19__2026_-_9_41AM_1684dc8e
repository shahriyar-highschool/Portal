async function readHistory(env, chatId) {
  try {
    const value = await env.MEMORY.get(`history:${chatId}`);
    return value ? JSON.parse(value) : [];
  } catch (error) {
    console.error("History read error:", String(error).slice(0, 300));
    return [];
  }
}

async function saveHistory(env, chatId, entry, options = {}) {
  const replace = options.replace === true;
  const history = await readHistory(env, chatId);
  const existingIndex = history.findIndex(item => item.id === entry.id);

  if (existingIndex !== -1) {
    if (!replace) return history;
    history[existingIndex] = { ...history[existingIndex], ...entry };
  } else {
    history.push(entry);
  }

  const recent = history.slice(-HISTORY_MAX);

  try {
    await env.MEMORY.put(`history:${chatId}`, JSON.stringify(recent));
  } catch (error) {
    console.error("History write error (non-fatal):", String(error).slice(0, 300));
  }

  return recent;
}

function historyForAI(history) {
  return history.slice(-HISTORY_CONTEXT_MAX).map(item => ({
    message_id: item.id,
    sender: item.sender,
    date_time: item.time,
    reply_to_message_id: item.reply_to_message_id || null,
    text: typeof item.text === "string" ? item.text.slice(0, HISTORY_TEXT_TRUNC) : ""
  }));
}

