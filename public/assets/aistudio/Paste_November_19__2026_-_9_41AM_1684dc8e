async function getScores(env, chatId) {
  try {
    const val = await env.MEMORY.get(`scores:${chatId}`);
    return val ? JSON.parse(val) : {};
  } catch (error) {
    console.error("Scores read error:", String(error).slice(0, 300));
    return {};
  }
}

async function addPoint(env, chatId, user, amount = 1) {
  if (!user || !user.id) return 0;
  try {
    const scores = await getScores(env, chatId);
    const userId = String(user.id);
    const name = user.first_name || "دانش‌آموز";
    const currentScore = (scores[userId]?.score || 0) + amount;

    scores[userId] = {
      id: user.id,
      name: name,
      score: currentScore
    };

    await env.MEMORY.put(`scores:${chatId}`, JSON.stringify(scores));
    return currentScore;
  } catch (error) {
    console.error("Score write error:", String(error).slice(0, 300));
    return 0;
  }
}

async function deductPoint(env, chatId, userId, amount) {
  try {
    const scores = await getScores(env, chatId);
    const uid = String(userId);
    const currentScore = scores[uid]?.score || 0;

    if (currentScore < amount) {
      return { success: false, currentScore };
    }

    scores[uid].score = currentScore - amount;
    await env.MEMORY.put(`scores:${chatId}`, JSON.stringify(scores));
    return { success: true, remaining: scores[uid].score, name: scores[uid].name };
  } catch (error) {
    console.error("Score deduct error:", String(error).slice(0, 300));
    return { success: false, currentScore: 0 };
  }
}

