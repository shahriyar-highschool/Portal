async function isUserVip(env, userId) {
  if (!userId) return false;
  try {
    const val = await env.MEMORY.get(`vip:${userId}`);
    return val === "1" || val === "true";
  } catch {
    return false;
  }
}

async function setUserVip(env, userId, status = true) {
  if (!userId) return false;
  try {
    if (status) {
      await env.MEMORY.put(`vip:${userId}`, "1");
    } else {
      await env.MEMORY.delete(`vip:${userId}`);
    }
    return true;
  } catch {
    return false;
  }
}

